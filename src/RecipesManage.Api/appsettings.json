{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
    "ConnectionStrings": {
      "Sqlite": "Data Source=App_Data/recipes.db"
    },
  "Jwt": {
    "Issuer": "RecipesManage",
    "Audience": "RecipesManage",
    "Key": "RecipesManage-dev-only-change-me-32bytes!!",
    "ExpireHours": 12
  },
  "Backup": {
    "Enabled": true,
    "AtUtc": "02:15",
    "Keep": 7,
    "Directory": "App_Data/backups"
  },
  "Maintenance": {
    "Enabled": true,
    "Vacuum": true,
    "MinFreeRatio": 0.2,
    "MinFreeMegabytes": 64,
    "BusyTimeoutMs": 30000
  }
}
