{
  "//": "生产模板：ASPNETCORE_ENVIRONMENT=Production 时叠加在 appsettings.json 之上。逐项说明见 docs/deployment.md。",
  "Seed": {
    "Demo": false,
    "AdminPassword": ""
  },
  "Jwt": {
    "Key": "CHANGE-ME-生产密钥至少 32 字节",
    "ExpireHours": 8
  },
  "Backup": {
    "Enabled": true,
    "AtUtc": "02:15",
    "Keep": 7,
    "KeepPreMigration": 3,
    "Directory": "App_Data/backups"
  },
  "Logging": {
    "File": {
      "Enabled": true,
      "Directory": "App_Data/logs",
      "MinimumLevel": "Information",
      "RetainedDays": 0
    }
  },
  "Maintenance": {
    "Enabled": true
  }
}
